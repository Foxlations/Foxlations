  "tutorialSlide1Title": "Welcome to Foxlations",
  "@tutorialSlide1Title": {
    "description": "Tutorial slide 1 title (Foxlations is the app's brand name, keep it)"
  },
  "tutorialSlide1Body": "One app for manga and manhwa, anime, and light novels - read, watch and listen, all from sources you add yourself. No account, no ads, nothing phoning home.",
  "@tutorialSlide1Body": {
    "description": "Tutorial slide 1 body: what the app is"
  },
  "tutorialSlide2Title": "Get your content",
  "@tutorialSlide2Title": {
    "description": "Tutorial slide 2 title"
  },
  "tutorialSlide2Body": "Foxlations ships empty - you choose the sources. In the Browse tab, open the ⋯ menu to add an extension repository (a link your community shares). Installed sources show up ready to search.",
  "@tutorialSlide2Body": {
    "description": "Tutorial slide 2 body: how to add source repositories"
  },
  "tutorialSlide3Title": "Build your library",
  "@tutorialSlide3Title": {
    "description": "Tutorial slide 3 title"
  },
  "tutorialSlide3Body": "Search a source or use global search across all of them, open a title, and tap the heart to add it. Your library is organized with categories (Reading, On-hold, your own…) and a “Continue reading” shortcut right up top.",
  "@tutorialSlide3Body": {
    "description": "Tutorial slide 3 body: searching and adding titles to the library"
  },
  "tutorialSlide4Title": "Read your way",
  "@tutorialSlide4Title": {
    "description": "Tutorial slide 4 title"
  },
  "tutorialSlide4Body": "Paged, webtoon or double-page; tap the edges to turn pages and the centre for controls. Dial in eye-comfort (warm filter + dim), customise the novel reader, let it read novels aloud, and skip anime intros automatically.",
  "@tutorialSlide4Body": {
    "description": "Tutorial slide 4 body: reader modes and options"
  },
  "tutorialSlide5Title": "Private & offline",
  "@tutorialSlide5Title": {
    "description": "Tutorial slide 5 title"
  },
  "tutorialSlide5Body": "Download chapters and episodes to read with no connection, back up your whole library, and keep private titles locked away in the Vault. There’s incognito mode and an app lock too.",
  "@tutorialSlide5Body": {
    "description": "Tutorial slide 5 body: downloads, backup, Vault, privacy"
  },
  "tutorialSlide6Title": "Join the community",
  "@tutorialSlide6Title": {
    "description": "Tutorial slide 6 title"
  },
  "tutorialSlide6Body": "Questions, source help, feature requests, or just want to chat? Come say hi on our Discord - and you can reopen this tour any time from Settings → Help & Tips.",
  "@tutorialSlide6Body": {
    "description": "Tutorial slide 6 body: inviting the user to the community Discord"
  },
